{
  "schemaVersion": 1,
  "name": "codex",
  "displayName": "codex",
  "role": "main",
  "requires": { "codingRuntime": ">=0.1.2 <1.0.0" },
  "env": { "CODEX_HOME": "${STATE_DIR}/codex" },
  "preflight": [{ "path": "${STATE_DIR}/codex", "mode": "700" }],
  "config": { "emitter": { "type": "module", "path": "/opt/adapter/emit.mjs" } },
  "serve": { "surface": "terminal", "port": 8080, "originGuard": true },
  "terminal": {
    "tmuxSession": "codex",
    "launch": ["launch-codex"],
    "cwd": "${WORKDIR}",
    "wsPath": "/ws",
    "keepaliveSeconds": 25
  }
}
